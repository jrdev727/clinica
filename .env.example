# Variables para docker-compose.yml. Copiar este archivo a ".env" en la
# raíz del repo (mismo nivel que docker-compose.yml) y completar valores
# propios antes de levantar el proyecto con "docker compose up -d --build".
#
# Nunca commitear el archivo ".env" real (ya está en .gitignore).

DB_USER=clinica
DB_PASSWORD=cambiar-esta-contrasena
DB_NAME=clinica_db

# Clave para firmar las sesiones. Generar una propia y larga, por ejemplo:
# openssl rand -base64 48
JWT_SECRET=cambiar-esta-clave-larga-y-unica
